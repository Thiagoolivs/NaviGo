# Copie para `.env` e ajuste. O `.env` NÃO é versionado.

# --- Django ---
DJANGO_SECRET_KEY=troque-por-uma-chave-secreta
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Banco de dados ---
# Sem esta variável, o projeto usa SQLite (bom para começar).
# Postgres (dev via docker-compose):
# DATABASE_URL=postgres://navigo:navigo@localhost:5432/navigo

# --- CORS (origem do PWA em dev) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Em dev, roda as tarefas de forma síncrona (sem worker):
CELERY_TASK_ALWAYS_EAGER=true

# --- Autenticação / e-mail ---
# Verificação de e-mail no cadastro: optional (dev) | mandatory (produção)
ACCOUNT_EMAIL_VERIFICATION=optional

# E-mail: por padrão imprime no console. Para usar o Resend, descomente:
# EMAIL_BACKEND=anymail.backends.resend.EmailBackend
# RESEND_API_KEY=re_xxx
DEFAULT_FROM_EMAIL=NaviGo <nao-responder@navigo.app>

# Google login (endpoint /api/v1/auth/google/) — preencher quando configurar:
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_CALLBACK_URL=postmessage

# --- Integrações ---
# PSP de PIX: dummy | asaas
PAYMENT_PROVIDER=dummy
# Asaas — troque PAYMENT_PROVIDER para "asaas" ao preencher a chave.
# ASAAS_API_KEY=$aact_...
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
# Token que você define no painel do Asaas e ele envia no header do webhook:
# ASAAS_WEBHOOK_TOKEN=

# Provedor de IA: dummy | gemini
AI_PROVIDER=dummy
# Gemini — troque AI_PROVIDER para "gemini" ao preencher a chave.
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
